# Required. Get one at https://console.groq.com/keys
# Copy this file to .env.local and put your key in it. .env.local is gitignored.
GROQ_API_KEY=gsk_your_key_here

# Optional. Pin a specific Groq chat model id for the drafting call.
# When unset (recommended), cite-guard reads the live catalogue from
# https://api.groq.com/openai/v1/models at runtime, filters out speech, guard
# and small-context models, and applies a preference order over whatever
# survives. An id that is not in the live catalogue is ignored.
# GROQ_MODEL=openai/gpt-oss-120b

# NOTE: GROQ_BASE_URL is deliberately NOT read. The Groq endpoint is hardcoded
# in src/lib/groq.ts so a stray environment variable cannot redirect a request
# carrying your API key to another host.
